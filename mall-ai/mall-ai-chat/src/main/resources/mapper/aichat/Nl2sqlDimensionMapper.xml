<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.aichat.mapper.Nl2sqlDimensionMapper">
    
    <resultMap type="Nl2sqlDimension" id="Nl2sqlDimensionResult">
        <result property="id"    column="id"    />
        <result property="dimName"    column="dim_name"    />
        <result property="tableName"    column="table_name"    />
        <result property="columnName"    column="column_name"    />
        <result property="synonyms"    column="synonyms"    />
        <result property="dimValues"    column="dim_values"    />
        <result property="enabled"    column="enabled"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectNl2sqlDimensionVo">
        select id, dim_name, table_name, column_name, synonyms, dim_values, enabled, create_by, create_time, update_by, update_time from nl2sql_dimension
    </sql>

    <select id="selectNl2sqlDimensionList" parameterType="Nl2sqlDimension" resultMap="Nl2sqlDimensionResult">
        <include refid="selectNl2sqlDimensionVo"/>
        <where>  
            <if test="dimName != null  and dimName != ''"> and dim_name like concat('%', #{dimName}, '%')</if>
            <if test="tableName != null  and tableName != ''"> and table_name like concat('%', #{tableName}, '%')</if>
            <if test="columnName != null  and columnName != ''"> and column_name like concat('%', #{columnName}, '%')</if>
            <if test="synonyms != null  and synonyms != ''"> and synonyms = #{synonyms}</if>
            <if test="dimValues != null  and dimValues != ''"> and dim_values = #{dimValues}</if>
            <if test="enabled != null  and enabled != ''"> and enabled = #{enabled}</if>
        </where>
    </select>
    
    <select id="selectNl2sqlDimensionById" parameterType="Long" resultMap="Nl2sqlDimensionResult">
        <include refid="selectNl2sqlDimensionVo"/>
        where id = #{id}
    </select>

    <insert id="insertNl2sqlDimension" parameterType="Nl2sqlDimension" useGeneratedKeys="true" keyProperty="id">
        insert into nl2sql_dimension
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dimName != null and dimName != ''">dim_name,</if>
            <if test="tableName != null and tableName != ''">table_name,</if>
            <if test="columnName != null and columnName != ''">column_name,</if>
            <if test="synonyms != null">synonyms,</if>
            <if test="dimValues != null">dim_values,</if>
            <if test="enabled != null">enabled,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dimName != null and dimName != ''">#{dimName},</if>
            <if test="tableName != null and tableName != ''">#{tableName},</if>
            <if test="columnName != null and columnName != ''">#{columnName},</if>
            <if test="synonyms != null">#{synonyms},</if>
            <if test="dimValues != null">#{dimValues},</if>
            <if test="enabled != null">#{enabled},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateNl2sqlDimension" parameterType="Nl2sqlDimension">
        update nl2sql_dimension
        <trim prefix="SET" suffixOverrides=",">
            <if test="dimName != null and dimName != ''">dim_name = #{dimName},</if>
            <if test="tableName != null and tableName != ''">table_name = #{tableName},</if>
            <if test="columnName != null and columnName != ''">column_name = #{columnName},</if>
            <if test="synonyms != null">synonyms = #{synonyms},</if>
            <if test="dimValues != null">dim_values = #{dimValues},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNl2sqlDimensionById" parameterType="Long">
        delete from nl2sql_dimension where id = #{id}
    </delete>

    <delete id="deleteNl2sqlDimensionByIds" parameterType="String">
        delete from nl2sql_dimension where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>